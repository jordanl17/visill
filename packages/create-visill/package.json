{
  "name": "create-visill",
  "version": "0.1.0-rc.1",
  "type": "module",
  "description": "Scaffold a new visill skill.",
  "keywords": [
    "visill",
    "claude",
    "skill",
    "scaffold",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
