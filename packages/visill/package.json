{
  "name": "@visill/sdk",
  "version": "0.1.0-rc.1",
  "description": "Widget-side runtime SDK for Claude visualize:show_widget skills.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "claude",
    "claude-skill",
    "widget",
    "sdk"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "pretest": "tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
