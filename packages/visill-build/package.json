{
  "name": "@visill/build",
  "version": "0.1.0-rc.2",
  "description": "Vite plugins for assembling visill widget skills.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "vite-plugin",
    "claude",
    "claude-skill",
    "widget"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lightningcss": "^1.28.0",
    "terser": "^5.36.0",
    "vite": "^5.0.0 || ^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lightningcss": "^1.28.0",
    "terser": "^5.36.0",
    "tsup": "^8.3.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
